{%- comment -%}
  Neon product card. Required: product
{%- endcomment -%}
<a class="nx-card nx-rv" href="{{ product.url }}">
  <div class="nx-pic">
    {%- if product.featured_image -%}
      {%- assign nx_alt = product.featured_image.alt | default: product.title -%}
      {{ product.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 1100px) 230px, (min-width: 720px) 30vw, 45vw', alt: nx_alt }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag }}
    {%- endif -%}
    {%- unless product.available -%}<span class="nx-tag">Sold out</span>{%- endunless -%}
  </div>
  <div class="nx-info">
    <p class="nx-name">{{ product.title }}</p>
    <p class="nx-price">{% if product.price_varies %}From {% endif %}{{ product.price_min | money }}</p>
  </div>
</a>
